{
  "manifest_version": 3,
  "name": "HomeTab",
  "version": "1.0.0",
  "description": "A fast, private new tab page with one-click tiles for your self-hosted apps. No tracking, no ads.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": ["storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
